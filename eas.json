{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.valtheria.fr/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.valtheria.fr/api"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://valtheria.fr/api"
      },
      "environment": "production",
      "ios": {
        "image": "latest"
      },
      "channel": "production"
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.valtheria.fr/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "fr-FR"
      }
    }
  }
}
